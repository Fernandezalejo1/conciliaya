# APP_PASSWORD: Contraseña única del panel. Sin esta variable el servidor
# responde 503 en el login y nadie puede entrar. Obligatoria en producción.
APP_PASSWORD=""

# SESSION_SECRET: Firma de las cookies de sesión. Si no se define se usa
# APP_PASSWORD. Cambiarla invalida todas las sesiones abiertas.
SESSION_SECRET=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DISCORD_WEBHOOK_URL: Optional. Discord webhook URL for task notifications.
# Create a webhook in your Discord server: Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=""
